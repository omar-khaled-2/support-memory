# OpenAI (used by memory service for LLM fact extraction and query service for answers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TEMPERATURE=0.0

# Source authority weights (higher wins over lower for contradictory facts)
SOURCE_WEIGHTS=contract=5,billing=3,salesforce=3,email=2,crm=2,support=1,agent_note=1,system=1,chat=0
